    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\n\n// ========================================\n// 1. CLEAN / NORMALIZE INPUT DATA\n// ========================================\n\nconst customerName = String(data.customerName || '').trim();\nconst phone = String(data.phone || '').trim();\nconst email = String(data.email || '').trim();\nconst address = String(data.address || '').trim();\nconst serviceType = String(data.serviceType || '').trim();\nconst issue = String(data.issue || '').trim();\nconst preferredTime = String(data.preferredTime || '').trim();\n\n// Convert values to real Boolean values\nconst emergency = String(data.emergency || '').trim().toLowerCase() === 'true';\nconst feeAgreed = String(data.feeAgreed || '').trim().toLowerCase() === 'true';\n\n\n// ========================================\n// 2. REQUIRED INFORMATION VALIDATION\n// ========================================\n\nconst missingFields = [];\n\nif (!customerName) {\n  missingFields.push('customerName');\n}\n\nif (!phone) {\n  missingFields.push('phone');\n}\n\n\n// ========================================\n// 3. PHONE NUMBER VALIDATION\n// ========================================\n\nlet phoneValid = true;\n\nif (!phone) {\n  phoneValid = false;\n} else {\n  const phoneDigits = phone.replace(/\\D/g, '');\n\n  if (phoneDigits.length < 10) {\n    phoneValid = false;\n  }\n}\n\n\n// ========================================\n// 4. EMERGENCY REQUEST VALIDATION\n// ========================================\n\nif (emergency === true) {\n\n  if (!address) {\n    missingFields.push('address');\n  }\n\n  if (!issue) {\n    missingFields.push('issue');\n  }\n}\n\n\n// ========================================\n// 5. ROUTINE REQUEST VALIDATION\n// ========================================\n\nif (emergency === false) {\n\n  if (!serviceType) {\n    missingFields.push('serviceType');\n  }\n\n  if (!preferredTime) {\n    missingFields.push('preferredTime');\n  }\n}\n\n\n// ========================================\n// 6. SERVICE AREA VALIDATION\n// ========================================\n\nconst supportedAreas = [\n  'austin',\n  'round rock',\n  'pflugerville',\n  'cedar park'\n];\n\nconst addressLower = address.toLowerCase();\n\nlet serviceArea = '';\n\nfor (const area of supportedAreas) {\n  if (addressLower.includes(area)) {\n    serviceArea = area;\n    break;\n  }\n}\n\nconst serviceAreaValid = serviceArea !== '';\n\n\n// ========================================\n// 7. EMERGENCY FEE AGREEMENT VALIDATION\n// ========================================\n\nlet emergencyFeeValid = true;\n\nif (emergency === true) {\n\n  if (feeAgreed !== true) {\n    emergencyFeeValid = false;\n  }\n}\n\n\n// ========================================\n// 8. FINAL VALIDATION\n// ========================================\n\nconst isValid =\n  missingFields.length === 0 &&\n  phoneValid &&\n  serviceAreaValid &&\n  emergencyFeeValid;\n\n\n// ========================================\n// 9. RETURN CLEAN DATA\n// ========================================\n\nreturn {\n  customerName,\n  phone,\n  email,\n  address,\n  serviceType,\n  issue,\n  emergency,\n  feeAgreed,\n  preferredTime,\n\n  phoneValid,\n  serviceAreaValid,\n  serviceArea,\n  emergencyFeeValid,\n\n  isValid,\n  missingFields\n};"
      },
