    {
      "parameters": {
        "jsCode": "\nconst data = $input.item.json;\n\n// ========================================\n// 1. CLEAN / NORMALIZE INPUT DATA\n// ========================================\n\nconst customerName = String(data.customerName ?? '').trim();\nconst phone = String(data.phone ?? '').trim();\nconst email = String(data.email ?? '').trim();\nconst address = String(data.address ?? '').trim();\nconst serviceType = String(data.serviceType ?? '').trim();\nconst issue = String(data.issue ?? '').trim();\nconst preferredTime = String(data.preferredTime ?? '').trim();\n\nconst emergency =\n  data.emergency === true ||\n  String(data.emergency ?? '').trim().toLowerCase() === 'true';\n\nconst feeAgreed =\n  data.feeAgreed === true ||\n  String(data.feeAgreed ?? '').trim().toLowerCase() === 'true';\n\n// ========================================\n// 2. CHECK FOR IMMEDIATE SAFETY HAZARDS\n// ========================================\n\nconst safetyHazardPattern =\n  /\\b(gas leak|gas smell|smell of gas|smells like gas|gas odor|gas odou?r|fire|smoke|sparks?|electrical danger|electrical hazard|electrical emergency|exposed wires|electrical shock|electric shock)\\b/i;\n\nconst safetyRisk = safetyHazardPattern.test(issue);\n\nconst safetyMessage = safetyRisk\n  ? 'IMMEDIATE SAFETY HAZARD: Move away from the danger to a safe location. If there is a gas smell, fire, smoke, sparks, or immediate electrical danger, contact 911 or the appropriate local emergency service. Do not operate switches or electrical equipment, or attempt repairs. This AI receptionist cannot dispatch emergency responders.'\n  : '';\n\n// ========================================\n// 3. REQUIRED INFORMATION VALIDATION\n// All requests require these fields.\n// Email remains optional.\n// ========================================\n\nconst missingFields = [];\n\nif (!customerName) {\n  missingFields.push('customerName');\n}\n\nif (!phone) {\n  missingFields.push('phone');\n}\n\nif (!address) {\n  missingFields.push('address');\n}\n\nif (!serviceType) {\n  missingFields.push('serviceType');\n}\n\nif (!issue) {\n  missingFields.push('issue');\n}\n\nif (!preferredTime) {\n  missingFields.push('preferredTime');\n}\n\n// ========================================\n// 4. PHONE NUMBER VALIDATION\n// ========================================\n\nlet phoneValid = false;\n\nif (phone) {\n  const phoneDigits = phone.replace(/\\D/g, '');\n  phoneValid = phoneDigits.length >= 10;\n}\n\n// ========================================\n// 5. SERVICE AREA VALIDATION\n// ========================================\n\nconst supportedAreas = [\n  'austin',\n  'round rock',\n  'pflugerville',\n  'cedar park'\n];\n\nconst addressLower = address.toLowerCase();\n\nlet serviceArea = '';\n\nfor (const area of supportedAreas) {\n  if (addressLower.includes(area)) {\n    serviceArea = area;\n    break;\n  }\n}\n\nconst serviceAreaValid = serviceArea !== '';\n\n// ========================================\n// 6. EMERGENCY FEE AGREEMENT VALIDATION\n// ========================================\n\nconst emergencyFeeValid = !emergency || feeAgreed;\n\n// ========================================\n// 7. FINAL VALIDATION\n// ========================================\n\nconst isValid =\n  missingFields.length === 0 &&\n  phoneValid &&\n  serviceAreaValid &&\n  emergencyFeeValid &&\n  !safetyRisk;\n\n// ========================================\n// 8. RETURN CLEAN DATA AND VALIDATION STATUS\n// ========================================\n\nreturn {\n  customerName,\n  phone,\n  email,\n  address,\n  serviceType,\n  issue,\n  emergency,\n  feeAgreed,\n  preferredTime,\n\n  phoneValid,\n  serviceAreaValid,\n  serviceArea,\n  emergencyFeeValid,\n\n  safetyRisk,\n  safetyMessage,\n\n  isValid,\n  missingFields\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
